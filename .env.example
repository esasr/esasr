# ── Published ports ───────────────────────────────────────────────────────────
WEB_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── Local infrastructure credentials ──────────────────────────────────────────
POSTGRES_DB=scholarseeker
POSTGRES_USER=scholarseeker
POSTGRES_PASSWORD=scholarseeker_pg_pass
NEO4J_USER=neo4j
NEO4J_PASSWORD=scholarseeker_neo4j_pass
NEO4J_DATABASE=neo4j
JWT_SECRET=change_me_to_a_long_random_string

# ── LLM provider ──────────────────────────────────────────────────────────────
# deepseek | qwen | openai | kimi | custom
LLM_ACTIVE_PROVIDER=deepseek
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=
# 使用 Kimi 时，将 LLM_ACTIVE_PROVIDER 改为 kimi，并在下方填写 Moonshot API Key
KIMI_API_KEY=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=https://api.example.com/v1
CUSTOM_LLM_MODEL=gpt-4o-mini

# ── Academic APIs ─────────────────────────────────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# ── Optional local Cross Encoder ──────────────────────────────────────────────
# Enabling this also requires building with INSTALL_RERANKER=true.
INSTALL_RERANKER=false
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
CROSS_ENCODER_DEVICE=cpu

SCHOLARSEEKER_DEBUG=false
