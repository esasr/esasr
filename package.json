{
  "name": "esasr-cli",
  "version": "1.0.0",
  "description": "Interactive installer and launcher for ESASR (Evidence-State Adaptive Scholarly Retrieval)",
  "type": "module",
  "bin": {
    "esasr": "bin/esasr.js"
  },
  "files": [
    "bin/",
    "templates/",
    "scripts/",
    "esasr-api/*.py",
    "esasr-api/Dockerfile",
    "esasr-api/requirements*.txt",
    "esasr-api/services/*.py",
    "esasr-api/routers/*.py",
    "esasr-api/tools/*.py",
    "esasr-api/tests/*.py",
    "esasr-api/evaluation/*.py",
    "esasr-api/evaluation/*.jsonl",
    "esasr-api/evaluation/*.md",
    "esasr-web/src/",
    "esasr-web/public/",
    "esasr-web/Dockerfile",
    "esasr-web/nginx.conf",
    "esasr-web/index.html",
    "esasr-web/env.d.ts",
    "esasr-web/package*.json",
    "esasr-web/tsconfig*.json",
    "esasr-web/vite.config.ts",
    ".env.example",
    "config_example.yaml",
    "docker-compose.yml",
    "run.sh",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "academic-search",
    "research",
    "llm",
    "paper-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esasr/esasr.git"
  },
  "homepage": "https://github.com/esasr/esasr#readme",
  "bugs": {
    "url": "https://github.com/esasr/esasr/issues"
  },
  "license": "MIT"
}
